# Server
SERVER_PORT=8080

# PostgreSQL — Eco creates the database and fills DATABASE_URL / DATABASE_USERNAME
# / DATABASE_PASSWORD when the service declares postgresql@15 in ecompose.yml.
DATABASE_URL=

# JWT (must match the shared secret used by the auth domain)
JWT_SECRET=

# CORS (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Public site origin used to build absolute canonical/OG URLs, e.g. https://crm.stuff8.com
# (Eco fills this from expose.hostname in production.)
PUBLIC_SITE_URL=

# Whether only admin/superadmin users may create articles (default true)
ARTICLES_ADMIN_ONLY=true
