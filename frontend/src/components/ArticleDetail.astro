---
/**
 * <ArticleDetail/> — renders a full published article body, Medium-style.
 * Receives the article as a prop (the SSR route fetches it); also usable
 * directly by a composition that already has the article object.
 */
import { renderMarkdown } from '../lib/api.js';

interface Props {
  article: {
    slug: string;
    title: string;
    excerpt?: string | null;
    contentMd: string;
    coverImageUrl?: string | null;
    tags?: string[];
    authorName: string;
    publishedAt?: string | null;
  };
}

const { article } = Astro.props;
const html = renderMarkdown(article.contentMd || '');
const date = article.publishedAt
  ? new Date(article.publishedAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })
  : '';
---

<article class="mx-auto max-w-3xl">
  {article.coverImageUrl && (
    <div class="mb-8 overflow-hidden rounded-2xl border border-navy-100">
      <img src={article.coverImageUrl} alt="" class="aspect-[16/9] w-full object-cover" />
    </div>
  )}

  <header class="mb-8">
    {article.tags && article.tags.length > 0 && (
      <p class="mb-3 flex flex-wrap gap-1.5">
        {article.tags.map((tag) => (
          <span class="rounded-md bg-paper-100 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-navy-600">{tag}</span>
        ))}
      </p>
    )}
    <h1 class="font-display text-3xl font-extrabold leading-tight tracking-tight text-navy-900 sm:text-4xl">{article.title}</h1>
    {article.excerpt && (
      <p class="mt-4 text-base leading-relaxed text-slate-600">{article.excerpt}</p>
    )}
    <p class="mt-5 border-t border-navy-100 pt-4 text-sm text-slate-500">
      By <span class="font-bold text-navy-900">{article.authorName}</span>
      {date && <span class="text-slate-400"> · {date}</span>}
    </p>
  </header>

  <div class="article-body" set:html={html} />
</article>

<style>
  .article-body {
    color: #27433a;
    font-size: 1.0625rem;
    line-height: 1.75;
  }
  .article-body :global(h1), .article-body :global(h2), .article-body :global(h3), .article-body :global(h4) {
    font-family: 'Bricolage Grotesque', ui-sans-serif, system-ui, sans-serif;
    font-weight: 800;
    color: #0f1e1a;
    letter-spacing: -0.01em;
    margin: 1.75em 0 0.5em;
    line-height: 1.3;
  }
  .article-body :global(h1) { font-size: 1.75rem; }
  .article-body :global(h2) { font-size: 1.5rem; }
  .article-body :global(h3) { font-size: 1.25rem; }
  .article-body :global(h4) { font-size: 1.1rem; }
  .article-body :global(p) { margin: 1.1em 0; }
  .article-body :global(a) { color: #047857; text-decoration: underline; text-underline-offset: 2px; }
  .article-body :global(strong) { font-weight: 700; color: #0f1e1a; }
  .article-body :global(blockquote) {
    margin: 1.5em 0;
    border-left: 3px solid #d65f2e;
    padding: 0.25em 0 0.25em 1.25em;
    color: #3a6656;
    font-style: italic;
  }
  .article-body :global(ul), .article-body :global(ol) { margin: 1.1em 0; padding-left: 1.5em; }
  .article-body :global(li) { margin: 0.4em 0; }
  .article-body :global(pre) {
    margin: 1.5em 0;
    padding: 1.25em;
    overflow-x: auto;
    border-radius: 0.75rem;
    background: #0f1e1a;
    color: #e2ece7;
    font-size: 0.875rem;
    line-height: 1.6;
  }
  .article-body :global(code) {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    background: #e2ece7;
    padding: 0.15em 0.4em;
    border-radius: 0.375rem;
    font-size: 0.875em;
  }
  .article-body :global(pre code) { background: transparent; padding: 0; font-size: 0.875rem; }
  .article-body :global(img) { max-width: 100%; border-radius: 0.75rem; margin: 1.5em 0; }
</style>
