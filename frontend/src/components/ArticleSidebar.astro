---
/**
 * ArticleSidebar — the on-page table of contents for the open article.
 * Shows the current article's heading structure (h2–h4) with anchor links,
 * VitePress "On this page" style. A scroll-spy highlights the section being
 * read. A link back to the full article list sits at the top.
 */
import { extractHeadings } from '../lib/api.js';

interface Heading {
  id: string;
  text: string;
  level: number;
}

interface Props {
  /** The open article's markdown body; its h2–h4 structure becomes the TOC. */
  contentMd: string;
  /** True when the sidebar is shown on a detail page. */
  active?: boolean;
}

const { contentMd = '', active = false } = Astro.props;
const headings: Heading[] = extractHeadings(contentMd);
const maxLevel = Math.min(...headings.map((h) => h.level), 2);
---

{
  active ? (
    <nav class="article-toc" aria-label="On this page">
      <p class="toc-label">On this page</p>
      <ul class="toc-list">
        {headings.length === 0 && (
          <li class="toc-empty">No sections in this article.</li>
        )}
        {headings.map((heading) => (
          <li>
            <a
              href={`#${heading.id}`}
              data-toc-heading={heading.id}
              class={heading.level === maxLevel ? 'toc-link' : 'toc-link toc-sub'}
            >
              <span class="tick" aria-hidden="true"></span>
              <span class="text">{heading.text}</span>
            </a>
          </li>
        ))}
      </ul>
      <a href="/articles/" class="toc-back">
        <svg class="back-arrow" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
        All articles
      </a>
    </nav>
  ) : (
    <div />
  )
}

<style>
  .article-toc {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .toc-label {
    margin: 0 0 0.75rem;
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #6f9d8c;
  }
  .toc-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }
  .toc-empty {
    font-size: 0.8125rem;
    color: #6f9d8c;
    padding: 0.25rem 0;
  }
  .toc-link {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    padding: 0.4rem 0.625rem;
    border-radius: 0.5rem;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: #2f5345;
    text-decoration: none;
    border-left: 2px solid transparent;
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .toc-sub {
    padding-left: 1.75rem;
    font-size: 0.78125rem;
    color: #4d806d;
  }
  .toc-link:hover {
    background: #eef5f1;
    color: #0f1e1a;
  }
  .toc-link.active {
    background: #eef5f1;
    color: #0f1e1a;
    font-weight: 700;
    border-left-color: #059669;
  }
  .toc-link .tick {
    flex: 0 0 auto;
    width: 0.375rem;
    height: 0.375rem;
    margin-top: 0.45em;
    border-radius: 9999px;
    background: #bfd8cc;
  }
  .toc-link.active .tick {
    background: #059669;
  }
  .toc-link .text {
    overflow-wrap: anywhere;
  }
  .toc-back {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: 1.25rem;
    padding: 0.375rem 0.625rem;
    border-radius: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 700;
    color: #047857;
    text-decoration: none;
  }
  .toc-back:hover {
    background: #eef5f1;
  }
  .back-arrow {
    width: 1rem;
    height: 1rem;
  }
</style>

<script>
  // Scroll-spy: highlight the TOC entry for the section currently in view.
  const links = Array.from(document.querySelectorAll('[data-toc-heading]'));
  if (links.length > 0) {
    const ids = links.map((link) => link.dataset.tocHeading);
    const heads = ids
      .map((id) => document.getElementById(id))
      .filter(Boolean);

    const setActive = (id) => {
      links.forEach((link) => {
        const on = link.dataset.tocHeading === id;
        link.classList.toggle('active', on);
        if (on) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      });
    };

    let current = null;
    const spy = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting && entry.intersectionRatio > 0) {
            current = entry.target.id;
            setActive(current);
          }
        }
      },
      { rootMargin: '-80px 0px -70% 0px', threshold: [0, 1] }
    );
    heads.forEach((heading) => spy.observe(heading));

    // Kick off with the first heading when the page loads below it.
    requestAnimationFrame(() => {
      if (!current) setActive(ids[0]);
    });
  }
</script>
